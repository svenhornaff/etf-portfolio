<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Portfolio report — {{ as_of.isoformat() }}</title>
<style>
:root {
  --bg: #eef1f7; --fg: #1a1f36; --card: #ffffff; --muted: #70778c;
  --border: #e4e8f1; --accent: #3b7ddd; --accent-soft: #eaf1fc;
  --pos: #1a9c57; --neg: #e5484d; --shadow: 0 1px 2px rgba(16,24,40,.04), 0 6px 16px rgba(16,24,40,.05);
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--fg);
  font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}
header { padding: 1.3rem 1.5rem; display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; align-items: baseline; max-width: 1180px; margin: 0 auto; }
header h1 { font-size: 1.25rem; margin: 0; font-weight: 700; }
header .meta { color: var(--muted); font-size: .82rem; min-width: 0; overflow-wrap: break-word; }
body { overflow-x: hidden; }
main { max-width: 1180px; margin: 0 auto; padding: 0 1.25rem 2rem; }
section { margin-bottom: 1.75rem; }
h2.section-title { font-size: 1.15rem; font-weight: 700; margin: 0 0 .9rem; color: var(--fg); }
h2.section-title .note { font-weight: 400; font-size: .8rem; }
h3 { font-size: .95rem; font-weight: 700; margin: 0 0 .7rem; }
.card { background: var(--card); border-radius: 16px; padding: 1.3rem 1.4rem; box-shadow: var(--shadow); min-width: 0; }
/* grid/flex children default to min-width:auto (their content's natural
   width), which silently overflows the viewport on narrow screens —
   override everywhere a table/long-text child could force that. */
.dash-row > *, .dash-row-3 > *, .cards > * { min-width: 0; }
.hero-head > div { min-width: 0; }

/* dashboard grid */
.dash-row { display: grid; grid-template-columns: 2fr 1fr; gap: 1rem; margin-bottom: 1rem; }
.dash-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
@media (max-width: 920px) { .dash-row, .dash-row-3 { grid-template-columns: 1fr; } }
@media (max-width: 640px) { header { flex-direction: column; align-items: flex-start; } }

.hero-head { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: .5rem; margin-bottom: .5rem; }
.hero-label { color: var(--muted); font-size: .85rem; }
.hero-value { font-size: 2rem; font-weight: 700; }
.range-tabs, .mini-tabs { display: flex; gap: 1rem; }
.range-tabs button, .mini-tabs button {
  background: none; border: none; color: var(--muted); font-size: .85rem; font-weight: 600;
  padding: .2rem 0; cursor: pointer; border-bottom: 2px solid transparent;
}
.range-tabs button.active, .mini-tabs button.active { color: var(--accent); border-bottom-color: var(--accent); }
.chart-wealth { position: relative; }
.chart-tooltip {
  position: absolute; pointer-events: none; background: #1a1f36; color: #fff; font-size: .78rem;
  padding: .45rem .6rem; border-radius: 8px; line-height: 1.4; white-space: nowrap; transform: translate(-50%, -115%);
  opacity: 0; transition: opacity .08s; z-index: 5;
}
.chart-tooltip.show { opacity: 1; }
.legend { display: flex; gap: 1.1rem; flex-wrap: wrap; margin-top: .8rem; font-size: .8rem; }
.legend .item { display: flex; align-items: center; gap: .4rem; cursor: pointer; color: var(--fg); user-select: none; }
.legend .item.off { opacity: .4; }
.legend .swatch { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }

.stat-list .row { display: flex; justify-content: space-between; padding: .55rem 0; border-bottom: 1px solid var(--border); font-size: .9rem; }
.stat-list .row:last-child { border-bottom: none; }
.stat-list .row span.k { color: var(--muted); }
.stat-list .row strong { font-weight: 700; }

.mini-table { width: 100%; border-collapse: collapse; font-size: .88rem; }
.mini-table td { padding: .5rem 0; border-bottom: 1px solid var(--border); }
.mini-table tr:last-child td { border-bottom: none; font-weight: 700; }
.mini-table td.num { text-align: right; width: 3.2rem; }
.mini-table td.buy { text-align: right; width: 3.2rem; color: var(--pos); }
.mini-table td.sell { text-align: right; width: 3.2rem; color: var(--neg); }

.donut-wrap { display: flex; align-items: center; gap: 1.2rem; }
.donut-legend { display: flex; flex-direction: column; gap: .5rem; font-size: .82rem; flex: 1; min-width: 0; }
.donut-legend .item { display: flex; justify-content: space-between; gap: .6rem; align-items: baseline; }
.donut-legend .item span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.donut-legend .item span:last-child { flex-shrink: 0; font-weight: 600; }
.donut-legend .dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; margin-right: .4rem; flex-shrink: 0; }

.dq-mini { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; margin-bottom: .8rem; }
.dq-mini .n { font-size: 1.3rem; font-weight: 700; }
.dq-mini .l { color: var(--muted); font-size: .76rem; }
.dq-mini .err .n { color: var(--neg); }
.dq-mini .warn .n { color: #c77c00; }
a.goto { color: var(--accent); font-size: .82rem; text-decoration: none; font-weight: 600; }

.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .75rem; }
.cards .card .label { color: var(--muted); font-size: .78rem; }
.cards .card .value { font-size: 1.3rem; font-weight: 700; margin-top: .15rem; }
.cards .card .reason { color: var(--muted); font-size: .74rem; margin-top: .2rem; }
.pos { color: var(--pos); } .neg { color: var(--neg); }

.table-scroll { overflow-x: auto; border-radius: 16px; box-shadow: var(--shadow); }
table.full { width: 100%; min-width: 640px; border-collapse: collapse; background: var(--card); }
table.full th, table.full td { padding: .6rem .8rem; text-align: right; border-bottom: 1px solid var(--border); font-size: .88rem; }
table.full th:first-child, table.full td:first-child, table.full th:nth-child(2), table.full td:nth-child(2) { text-align: left; }
table.full thead th { color: var(--muted); font-weight: 700; font-size: .74rem; text-transform: uppercase; letter-spacing: .03em; }
table.full tbody tr:last-child td { border-bottom: none; }

.amt.hidden { filter: blur(6px); user-select: none; }
.toggle { margin-left: auto; font-size: .82rem; cursor: pointer; color: var(--accent); background: var(--accent-soft); border: none; border-radius: 8px; padding: .4rem .7rem; font-weight: 600; }
.dq-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .4rem; }
.dq-list li { background: var(--card); border-left: 4px solid var(--muted); border-radius: 10px; padding: .55rem .75rem; font-size: .83rem; box-shadow: var(--shadow); }
.dq-list li.error { border-left-color: var(--neg); }
.dq-list li.warning { border-left-color: #c77c00; }
.badge-ok { color: var(--pos); } .badge-bad { color: var(--neg); }
.chart-wrap { background: var(--card); border-radius: 16px; padding: 1.1rem; overflow-x: auto; box-shadow: var(--shadow); }
svg.chart text { fill: var(--muted); font-size: 10px; }
svg.chart .bar { fill: var(--accent); }
svg.chart .bar.neg { fill: var(--neg); }
.goal-sim { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.goal-sim label { display: block; font-size: .8rem; color: var(--muted); margin-top: .6rem; }
.goal-sim input[type=range] { width: 100%; accent-color: var(--accent); }
.goal-sim .out .value { font-size: 1.1rem; }
.note { color: var(--muted); font-size: .78rem; }
footer { text-align: center; color: var(--muted); font-size: .78rem; padding: 2rem 0; }
@media (max-width: 640px) { .goal-sim { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<header>
  <h1>Portfolio Cockpit</h1>
  <span class="meta">as of {{ as_of.isoformat() }} · source: {{ source_file }} · parser v{{ parser_version }}</span>
  <button class="toggle" id="hide-toggle" type="button">Hide amounts</button>
</header>
<main>

<section>
  <div class="dash-row">
    <div class="card hero">
      <div class="hero-head">
        <div>
          <div class="hero-label">Depot + Cash</div>
          <div class="hero-value amt">{% if kpis.value is not none %}{{ kpis.value | eur }}{% if kpis.value_partial %} *{% endif %}{% else %}{{ kpis.net_contributions | eur }} <span class="note">(eingezahlt, keine Kurse geladen)</span>{% endif %}</div>
        </div>
        <div class="range-tabs" id="range-tabs">
          <button data-range="90">3M</button>
          <button data-range="365">1J</button>
          <button data-range="0" class="active">MAX</button>
        </div>
      </div>
      <div class="chart-wealth">
        <div id="chart-wealth"></div>
        <div class="chart-tooltip" id="chart-tooltip"></div>
      </div>
      <div class="legend" id="wealth-legend"></div>
      {% if kpis.twr_start %}<div class="note" style="margin-top:.4rem">Depotwert-Linie seit {{ kpis.twr_start.isoformat() }} — davor fehlt der Kurs für mittlerweile verkaufte Positionen ohne konfigurierten Ticker.</div>{% endif %}
    </div>

    <div class="card stat-list">
      <h3>Gesamtentwicklung</h3>
      <div class="row"><span class="k">Depotwert</span><strong class="amt">{{ (kpis.value - cash_sum) | eur if kpis.value is not none else "n/a" }}</strong></div>
      <div class="row"><span class="k">Cash-Bestand</span><strong class="amt">{{ cash_sum | eur }}</strong></div>
      <div class="row"><span class="k">Gesamt (Depot + Cash)</span><strong class="amt">{{ kpis.value | eur if kpis.value is not none else "n/a" }}</strong></div>
      <div class="row"><span class="k">Einzahlungen</span><strong class="amt">{{ kpis.net_contributions | eur }}</strong></div>
      <div class="row"><span class="k">Auszahlungen</span><strong class="amt">{{ withdrawals_sum | eur }}</strong></div>
      <div class="row"><span class="k" title="Eigene Kennzahl: Gain € ÷ Einzahlungen — keine Brokerberechnung">Performance auf Einlage</span>
        <strong class="{{ 'pos' if perf_on_deposit and perf_on_deposit > 0 else 'neg' if perf_on_deposit and perf_on_deposit < 0 else '' }}">{{ perf_on_deposit | pct if perf_on_deposit is not none else "n/a" }}</strong></div>
    </div>
  </div>

  <div class="dash-row-3">
    <div class="card">
      <h3>Meine Trades</h3>
      <table class="mini-table">
        {% for b in trade_buckets %}
        <tr><td>{{ b.label }}</td><td class="num">{{ b.buy + b.sell }}</td><td class="buy">{{ b.buy }}</td><td class="sell">{{ b.sell }}</td></tr>
        {% endfor %}
      </table>
    </div>

    <div class="card">
      <div class="hero-head" style="margin-bottom:.9rem">
        <h3 style="margin:0">Allocation</h3>
        <div class="mini-tabs" id="donut-tabs">
          <button data-tab="top" class="active">Top Positionen</button>
          <button data-tab="class">Assetklasse</button>
        </div>
      </div>
      <div class="donut-wrap">
        <div id="chart-donut"></div>
        <div class="donut-legend" id="donut-legend"></div>
      </div>
    </div>

    <div class="card">
      <h3>Datenqualität</h3>
      <div class="dq-mini">
        <div><div class="n">{{ event_count }}</div><div class="l">Buchungen</div></div>
        <div><div class="n">{{ unknown_count }}</div><div class="l">Unbekannt</div></div>
        <div class="err"><div class="n">{{ dq_error_count }}</div><div class="l">Fehler</div></div>
        <div class="warn"><div class="n">{{ dq_warning_count }}</div><div class="l">Warnungen</div></div>
      </div>
      <a class="goto" href="#data-quality">Details ↓</a>
    </div>
  </div>
</section>

<section>
  <h2 class="section-title">Weitere Kennzahlen</h2>
  <div class="cards">
    <div class="card"><div class="label">XIRR</div>
      <div class="value {{ 'pos' if kpis.xirr and kpis.xirr > 0 else 'neg' if kpis.xirr and kpis.xirr < 0 else '' }}">{{ kpis.xirr | pct if kpis.xirr is not none else "n/a" }}</div>
      {% if kpis.xirr is none %}<div class="reason">prices not loaded, or no sign change</div>{% endif %}
    </div>
    <div class="card"><div class="label">TWR</div>
      <div class="value {{ 'pos' if kpis.twr and kpis.twr > 0 else 'neg' if kpis.twr and kpis.twr < 0 else '' }}">{{ kpis.twr | pct if kpis.twr is not none else "n/a" }}</div>
      {% if kpis.twr is none %}<div class="reason">prices not loaded</div>{% endif %}
    </div>
    <div class="card"><div class="label">Max drawdown</div>
      <div class="value neg">{{ kpis.max_drawdown | pct if kpis.max_drawdown is not none else "n/a" }}</div>
      {% if kpis.max_drawdown is none %}<div class="reason">prices not loaded</div>{% endif %}
    </div>
    <div class="card"><div class="label">Invested (cost basis)</div><div class="value amt">{{ kpis.invested | eur }}</div></div>
    <div class="card"><div class="label">Realized gain</div><div class="value amt {{ 'pos' if kpis.realized > 0 else 'neg' if kpis.realized < 0 else '' }}">{{ kpis.realized | eur(true) }}</div></div>
    <div class="card"><div class="label">Taxes (net)</div><div class="value amt">{{ kpis.taxes | eur(true) }}</div></div>
    <div class="card"><div class="label">Dividends</div><div class="value amt">{{ kpis.dividends | eur }}</div></div>
  </div>
</section>

<section>
  <h2 class="section-title">Holdings</h2>
  <div class="table-scroll">
  <table class="full">
    <thead><tr><th>ISIN</th><th>Name</th><th>Qty</th><th>Avg cost</th><th>Price</th><th>Value</th><th>Weight</th><th>Unrealized</th></tr></thead>
    <tbody>
    {% for h in holdings %}
      <tr>
        <td>{{ h.isin }}</td>
        <td>{{ h.name }}</td>
        <td class="amt">{{ h.qty | qty }}</td>
        <td class="amt">{{ h.avg_cost | eur if h.avg_cost is not none else "n/a" }}</td>
        <td class="amt">{{ h.price | eur if h.price is not none else "n/a" }}{% if h.price_date %} <span class="note">({{ h.price_date.isoformat() }})</span>{% endif %}</td>
        <td class="amt">{{ h.value | eur if h.value is not none else "n/a" }}</td>
        <td>{{ (h.weight | pct) if h.weight is not none else "n/a" }}</td>
        <td class="amt {{ 'pos' if h.unrealized and h.unrealized > 0 else 'neg' if h.unrealized and h.unrealized < 0 else '' }}">
          {{ h.unrealized | eur(true) if h.unrealized is not none else "n/a" }}{% if h.unrealized_pct is not none %} ({{ h.unrealized_pct | pct }}){% endif %}
        </td>
      </tr>
    {% else %}
      <tr><td colspan="8">No open positions.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>

<section>
  <h2 class="section-title">Monatsdetail</h2>
  <div class="dash-row-3">
    <div class="chart-wrap"><h3>Einzahlungen / Monat</h3><div id="chart-savings"></div></div>
    <div class="chart-wrap"><h3>Trades / Monat (netto €)</h3><div id="chart-trades"></div></div>
    <div class="chart-wrap"><h3>Steuern &amp; Erträge / Monat</h3><div id="chart-income"></div></div>
  </div>
</section>

<section>
  <h2 class="section-title">Realized gains</h2>
  <div class="table-scroll">
  <table class="full">
    <thead><tr><th>ISIN</th><th>Realized</th></tr></thead>
    <tbody>
    {% for isin, amt in realized_by_isin.items() %}
      <tr><td>{{ isin }}</td><td class="amt {{ 'pos' if amt > 0 else 'neg' }}">{{ amt | eur(true) }}</td></tr>
    {% else %}
      <tr><td colspan="2">No realized gains yet.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <h3 style="margin-top:1.2rem">Sell list</h3>
  <div class="table-scroll">
  <table class="full">
    <thead><tr><th>Date</th><th>ISIN</th><th>Qty</th><th>Proceeds</th><th>Cost</th><th>Gain</th></tr></thead>
    <tbody>
    {% for s in sells %}
      <tr>
        <td>{{ s.date.isoformat() }}</td><td>{{ s.name or s.isin }}</td>
        <td class="amt">{{ s.qty | qty }}</td>
        <td class="amt">{{ s.proceeds | eur }}</td>
        <td class="amt">{{ s.cost | eur }}</td>
        <td class="amt {{ 'pos' if s.gain > 0 else 'neg' }}">{{ s.gain | eur(true) }}</td>
      </tr>
    {% else %}
      <tr><td colspan="6">No sells.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>

<section>
  <h2 class="section-title">Goal simulator <span class="note">— illustrative, constant return, not a forecast</span></h2>
  <div class="card goal-sim">
    <div>
      <label>Monthly saving: € <span id="g-saving-out"></span></label>
      <input type="range" id="g-saving" min="0" max="3000" step="50" value="{{ goal.monthly_saving | default(700) }}">
      <label>Years: <span id="g-years-out"></span></label>
      <input type="range" id="g-years" min="1" max="40" step="1" value="{{ goal.years | default(10) }}">
      <label>Annual return: <span id="g-return-out"></span></label>
      <input type="range" id="g-return" min="0" max="15" step="0.5" value="7">
      <label>Inflation: <span id="g-inflation-out"></span></label>
      <input type="range" id="g-inflation" min="0" max="10" step="0.1" value="{{ (goal.inflation | default(0.02) * 100) }}">
      <label>Withdrawal years: <span id="g-wyears-out"></span></label>
      <input type="range" id="g-wyears" min="1" max="40" step="1" value="20">
    </div>
    <div class="out">
      <div class="card" style="box-shadow:none;border:1px solid var(--border)"><div class="label">Start value (current portfolio value)</div><div class="value">{{ kpis.value | eur if kpis.value is not none else "0,00 €" }}</div></div>
      <div class="card" style="box-shadow:none;border:1px solid var(--border)"><div class="label">Future value (nominal)</div><div class="value" id="g-fv-nominal">—</div></div>
      <div class="card" style="box-shadow:none;border:1px solid var(--border)"><div class="label">Future value (real)</div><div class="value" id="g-fv-real">—</div></div>
      <div class="card" style="box-shadow:none;border:1px solid var(--border)"><div class="label">Monthly withdrawal (annuity)</div><div class="value" id="g-withdrawal">—</div></div>
    </div>
  </div>
</section>

<section>
  <h2 class="section-title">Reconciliation — Vorabpauschale checkpoints</h2>
  <div class="table-scroll">
  <table class="full">
    <thead><tr><th>ISIN</th><th>Name</th><th>Checkpoint</th><th>Stated qty</th><th>Reconstructed qty</th><th>Match</th></tr></thead>
    <tbody>
    {% for v in vap_checks %}
      <tr>
        <td>{{ v.isin }}</td><td>{{ v.name }}</td><td>{{ v.checkpoint.isoformat() }}</td>
        <td class="amt">{{ v.stated_qty | qty }}</td><td class="amt">{{ v.reconstructed_qty | qty }}</td>
        <td class="{{ 'badge-ok' if v.ok else 'badge-bad' }}">{{ "✓" if v.ok else "✗ diff " + (v.diff | qty) }}</td>
      </tr>
    {% else %}
      <tr><td colspan="6">No Vorabpauschale checkpoints in this export.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>

<section id="data-quality">
  <h2 class="section-title">Data quality <span class="note">({{ event_count }} rows, {{ unknown_count }} unknown, {{ buy_count }} buys, {{ sell_count }} sells, cash Σ {{ cash_sum | eur }})</span></h2>
  <ul class="dq-list">
  {% for item in dq_items %}
    <li class="{{ item.severity }}">{{ item.message }}</li>
  {% else %}
    <li>No data-quality issues found.</li>
  {% endfor %}
  </ul>
</section>

</main>
<footer>Generated locally — no server, no database, no network calls except optional price fetching.</footer>

<script id="report-data" type="application/json">{{ data_json | safe }}</script>
<script>
(function () {
  "use strict";
  var data;
  try {
    data = JSON.parse(document.getElementById("report-data").textContent);
  } catch (e) {
    console.error("report data failed to parse", e);
    data = { savings_by_month: {}, trades_by_month: {}, income_by_month: {}, holdings_weights: {}, holdings_names: {}, asset_class_weights: {}, wealth: {} };
  }

  document.getElementById("hide-toggle").addEventListener("click", function () {
    document.querySelectorAll(".amt").forEach(function (el) { el.classList.toggle("hidden"); });
  });

  function fmtEur(v) {
    return (v < 0 ? "-" : "") + Math.abs(v).toLocaleString("de-DE", { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + " €";
  }
  function fmtEurFull(v) {
    return (v < 0 ? "-" : "") + Math.abs(v).toLocaleString("de-DE", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €";
  }
  function fmtDate(ms) {
    return new Date(ms).toLocaleDateString("de-DE", { day: "2-digit", month: "short", year: "numeric" });
  }

  // ---------------------------------------------------------------------
  // Minimal dependency-free SVG chart renderers. No vendored library, no
  // CDN — works fully offline, same spirit as the rest of this report.
  // ---------------------------------------------------------------------

  function barChart(el, series) {
    var w = Math.max(360, series.length * 46), h = 160, padBottom = 20;
    var max = Math.max(1, ...series.map(function (s) { return Math.abs(s.value); }));
    var svg = ['<svg class="chart" width="' + w + '" height="' + (h + padBottom) + '" viewBox="0 0 ' + w + ' ' + (h + padBottom) + '">'];
    series.forEach(function (s, i) {
      var bw = (w / series.length) * 0.6;
      var x = (w / series.length) * i + (w / series.length - bw) / 2;
      var bh = Math.abs(s.value) / max * (h - 10);
      var y = h - bh;
      svg.push('<rect class="bar' + (s.value < 0 ? ' neg' : '') + '" x="' + x + '" y="' + y + '" width="' + bw + '" height="' + Math.max(1, bh) + '" rx="2"><title>' + s.label + ": " + fmtEurFull(s.value) + '</title></rect>');
      svg.push('<text x="' + (x + bw / 2) + '" y="' + (h + 14) + '" text-anchor="middle">' + s.label + '</text>');
    });
    svg.push('</svg>');
    el.innerHTML = svg.join("");
  }

  function monthSeries(obj, key) {
    return Object.keys(obj).sort().map(function (m) {
      return { label: m.slice(2), value: key ? (obj[m][key] || 0) : obj[m] };
    });
  }

  var savings = monthSeries(data.savings_by_month, null);
  if (savings.length) barChart(document.getElementById("chart-savings"), savings);

  var trades = Object.keys(data.trades_by_month).sort().map(function (m) {
    var b = data.trades_by_month[m];
    return { label: m.slice(2), value: (b.buy_amt || 0) - (b.sell_amt || 0) };
  });
  if (trades.length) barChart(document.getElementById("chart-trades"), trades);

  var income = Object.keys(data.income_by_month).sort().map(function (m) {
    var b = data.income_by_month[m];
    return { label: m.slice(2), value: (b.dividend || 0) + (b.tax || 0) + (b.tax_vap || 0) + (b.fee || 0) };
  });
  if (income.length) barChart(document.getElementById("chart-income"), income);

  // --- Allocation donut ---------------------------------------------------
  var PALETTE = ["#3b7ddd", "#36b37e", "#f2994a", "#9b51e0", "#e5484d", "#2456a6", "#17a2b8"];

  function donutChart(elSvg, elLegend, weights, labels) {
    var entries = Object.keys(weights).map(function (k) { return { key: k, label: (labels && labels[k]) || k, value: weights[k] }; });
    entries.sort(function (a, b) { return b.value - a.value; });
    var size = 160, r = 60, cx = size / 2, cy = size / 2, circumference = 2 * Math.PI * r;
    var offset = 0;
    var arcs = [];
    entries.forEach(function (e, i) {
      var len = e.value * circumference;
      arcs.push('<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="none" stroke="' + PALETTE[i % PALETTE.length] +
        '" stroke-width="22" stroke-dasharray="' + len + ' ' + (circumference - len) + '" stroke-dashoffset="' + (-offset) +
        '" transform="rotate(-90 ' + cx + ' ' + cy + ')"><title>' + e.label + ": " + (e.value * 100).toFixed(1) + '%</title></circle>');
      offset += len;
    });
    elSvg.innerHTML = '<svg width="' + size + '" height="' + size + '" viewBox="0 0 ' + size + ' ' + size + '">' + arcs.join("") + "</svg>";
    elLegend.innerHTML = entries.map(function (e, i) {
      return '<div class="item"><span title="' + e.label + '"><span class="dot" style="background:' + PALETTE[i % PALETTE.length] + '"></span>' + e.label +
        '</span><span>' + (e.value * 100).toFixed(1) + ' %</span></div>';
    }).join("");
  }

  var donutSvg = document.getElementById("chart-donut");
  var donutLegend = document.getElementById("donut-legend");
  function renderDonut(tab) {
    if (tab === "class") {
      donutChart(donutSvg, donutLegend, data.asset_class_weights || {});
    } else {
      donutChart(donutSvg, donutLegend, data.holdings_weights || {}, data.holdings_names || {});
    }
  }
  document.querySelectorAll("#donut-tabs button").forEach(function (btn) {
    btn.addEventListener("click", function () {
      document.querySelectorAll("#donut-tabs button").forEach(function (b) { b.classList.remove("active"); });
      btn.classList.add("active");
      renderDonut(btn.dataset.tab);
    });
  });
  renderDonut("top");

  // --- Wealth chart: portfolio value vs invested capital vs benchmark ----
  var wealth = data.wealth || {};
  function toPoints(series) {
    return (series || []).map(function (p) { return { t: new Date(p[0]).getTime(), v: p[1] }; });
  }
  var SERIES_DEF = [
    { key: "value", label: "Depotwert", color: "#3b7ddd", dash: "", fill: true },
    { key: "invested", label: "Einzahlungen", color: "#9aa4bb", dash: "6,4", fill: false },
    { key: "benchmark", label: wealth.benchmark_name || "Benchmark", color: "#36b37e", dash: "2,3", fill: false },
  ];
  var seriesPoints = {};
  SERIES_DEF.forEach(function (s) { seriesPoints[s.key] = toPoints(wealth[s.key]); });
  var hidden = {};
  var currentRangeDays = 0;

  var wealthEl = document.getElementById("chart-wealth");
  var tooltipEl = document.getElementById("chart-tooltip");
  var legendEl = document.getElementById("wealth-legend");

  function renderWealthChart() {
    var w = 760, h = 300, padL = 64, padR = 12, padT = 16, padB = 28;
    var innerW = w - padL - padR, innerH = h - padT - padB;

    var allT = seriesPoints.invested.map(function (p) { return p.t; });
    if (!allT.length) { wealthEl.innerHTML = '<p class="note">No cash-flow history to chart.</p>'; return; }
    var maxT = Math.max.apply(null, allT);
    var minT = currentRangeDays > 0 ? maxT - currentRangeDays * 86400000 : Math.min.apply(null, allT);

    var visible = SERIES_DEF.filter(function (s) { return !hidden[s.key] && seriesPoints[s.key].length; });
    var allV = [];
    visible.forEach(function (s) {
      seriesPoints[s.key].forEach(function (p) { if (p.t >= minT) allV.push(p.v); });
    });
    if (!allV.length) allV = [0, 1];
    var minV = Math.min(0, Math.min.apply(null, allV));
    var maxV = Math.max.apply(null, allV) * 1.08 || 1;

    function xScale(t) { return padL + (t - minT) / (maxT - minT || 1) * innerW; }
    function yScale(v) { return padT + innerH - (v - minV) / (maxV - minV || 1) * innerH; }

    var svg = ['<svg class="chart" width="100%" height="' + h + '" viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="xMinYMin meet" id="wealth-svg">'];

    // gridlines + y labels
    for (var g = 0; g <= 3; g++) {
      var v = minV + (maxV - minV) * g / 3;
      var y = yScale(v);
      svg.push('<line x1="' + padL + '" y1="' + y + '" x2="' + (w - padR) + '" y2="' + y + '" stroke="#e4e8f1" stroke-width="1"/>');
      svg.push('<text x="' + (padL - 10) + '" y="' + (y + 3) + '" text-anchor="end">' + fmtEur(v) + '</text>');
    }
    // x labels: first / mid / last of visible range (end ones anchored
    // inward so they can't overflow the viewBox and get clipped)
    svg.push('<text x="' + padL + '" y="' + (h - 6) + '" text-anchor="start">' + fmtDate(minT).slice(3) + '</text>');
    svg.push('<text x="' + xScale((minT + maxT) / 2) + '" y="' + (h - 6) + '" text-anchor="middle">' + fmtDate((minT + maxT) / 2).slice(3) + '</text>');
    svg.push('<text x="' + (w - padR) + '" y="' + (h - 6) + '" text-anchor="end">' + fmtDate(maxT).slice(3) + '</text>');

    visible.forEach(function (s) {
      var pts = seriesPoints[s.key].filter(function (p) { return p.t >= minT; });
      if (!pts.length) return;
      var d = pts.map(function (p, i) { return (i === 0 ? "M" : "L") + xScale(p.t).toFixed(1) + "," + yScale(p.v).toFixed(1); }).join(" ");
      if (s.fill) {
        var area = d + " L" + xScale(pts[pts.length - 1].t).toFixed(1) + "," + yScale(minV).toFixed(1) +
          " L" + xScale(pts[0].t).toFixed(1) + "," + yScale(minV).toFixed(1) + " Z";
        svg.push('<path d="' + area + '" fill="' + s.color + '" opacity="0.12" stroke="none"/>');
      }
      svg.push('<path d="' + d + '" fill="none" stroke="' + s.color + '" stroke-width="2"' + (s.dash ? ' stroke-dasharray="' + s.dash + '"' : "") + "/>");
    });

    svg.push("</svg>");
    wealthEl.innerHTML = svg.join("");

    var svgEl = document.getElementById("wealth-svg");
    svgEl.addEventListener("mousemove", function (evt) {
      var rect = svgEl.getBoundingClientRect();
      var relX = (evt.clientX - rect.left) / rect.width * w;
      var t = minT + (relX - padL) / innerW * (maxT - minT);
      if (t < minT || t > maxT) { tooltipEl.classList.remove("show"); return; }
      var lines = [fmtDate(t)];
      visible.forEach(function (s) {
        var pts = seriesPoints[s.key];
        var nearest = pts.reduce(function (best, p) { return Math.abs(p.t - t) < Math.abs(best.t - t) ? p : best; }, pts[0]);
        lines.push(s.label + ": " + fmtEurFull(nearest.v));
      });
      tooltipEl.innerHTML = lines.join("<br>");
      tooltipEl.style.left = (evt.clientX - rect.left) + "px";
      tooltipEl.style.top = (evt.clientY - rect.top) + "px";
      tooltipEl.classList.add("show");
    });
    svgEl.addEventListener("mouseleave", function () { tooltipEl.classList.remove("show"); });

    legendEl.innerHTML = SERIES_DEF.filter(function (s) { return seriesPoints[s.key].length; }).map(function (s) {
      return '<span class="item' + (hidden[s.key] ? " off" : "") + '" data-key="' + s.key + '">' +
        '<span class="swatch" style="background:' + s.color + '"></span>' + s.label + '</span>';
    }).join("");
    legendEl.querySelectorAll(".item").forEach(function (item) {
      item.addEventListener("click", function () {
        hidden[item.dataset.key] = !hidden[item.dataset.key];
        renderWealthChart();
      });
    });
  }

  document.querySelectorAll("#range-tabs button").forEach(function (btn) {
    btn.addEventListener("click", function () {
      document.querySelectorAll("#range-tabs button").forEach(function (b) { b.classList.remove("active"); });
      btn.classList.add("active");
      currentRangeDays = parseInt(btn.dataset.range, 10);
      renderWealthChart();
    });
  });
  renderWealthChart();

  // --- Goal simulator (pure JS, live, constant-return illustration) -------
  var els = {
    saving: document.getElementById("g-saving"),
    years: document.getElementById("g-years"),
    ret: document.getElementById("g-return"),
    inflation: document.getElementById("g-inflation"),
    wyears: document.getElementById("g-wyears"),
  };
  var outs = {
    saving: document.getElementById("g-saving-out"),
    years: document.getElementById("g-years-out"),
    ret: document.getElementById("g-return-out"),
    inflation: document.getElementById("g-inflation-out"),
    wyears: document.getElementById("g-wyears-out"),
  };
  var startValue = {{ (kpis.value or 0) | float }};

  function recompute() {
    var S = parseFloat(els.saving.value);
    var years = parseInt(els.years.value, 10);
    var rAnnual = parseFloat(els.ret.value) / 100;
    var infl = parseFloat(els.inflation.value) / 100;
    var wyears = parseInt(els.wyears.value, 10);

    outs.saving.textContent = S.toFixed(0);
    outs.years.textContent = years;
    outs.ret.textContent = (rAnnual * 100).toFixed(1) + " %";
    outs.inflation.textContent = (infl * 100).toFixed(1) + " %";
    outs.wyears.textContent = wyears;

    var i = Math.pow(1 + rAnnual, 1 / 12) - 1;
    var n = years * 12;
    var fv;
    if (Math.abs(i) < 1e-9) {
      fv = startValue + S * n;
    } else {
      fv = startValue * Math.pow(1 + i, n) + S * (Math.pow(1 + i, n) - 1) / i;
    }
    var m = wyears * 12;
    var withdrawal;
    if (Math.abs(i) < 1e-9) {
      withdrawal = fv / m;
    } else {
      withdrawal = (fv * i) / (1 - Math.pow(1 + i, -m));
    }
    var realRate = (1 + rAnnual) / (1 + infl) - 1;
    var iReal = Math.pow(1 + realRate, 1 / 12) - 1;
    var fvReal;
    if (Math.abs(iReal) < 1e-9) {
      fvReal = startValue + S * n;
    } else {
      fvReal = startValue * Math.pow(1 + iReal, n) + S * (Math.pow(1 + iReal, n) - 1) / iReal;
    }

    document.getElementById("g-fv-nominal").textContent = fmtEurFull(fv);
    document.getElementById("g-fv-real").textContent = fmtEurFull(fvReal);
    document.getElementById("g-withdrawal").textContent = fmtEurFull(withdrawal) + " / month";
  }

  Object.keys(els).forEach(function (k) { els[k].addEventListener("input", recompute); });
  recompute();
})();
</script>
</body>
</html>
